# SchoolOS Frontend environment variables
# Copy to .env.local for local development, or configure on your host platform.
# Do not commit real secrets.

# Server-side API base for Next.js rewrites (/v1/*).
# Optional when your edge proxy already routes /v1/* directly to backend.
# Set API origin without trailing slash.
# Example: https://api.schoolos.com or http://api:4000
BACKEND_URL=http://localhost:3001

# Public API base used by server-side theme fetch and public links.
# You can set with or without /v1; code normalizes it.
# Example: https://api.schoolos.com/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Platform domain for school subdomain resolution
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost

# Optional for local development when tenant is resolved by header
# NEXT_PUBLIC_SCHOOL_ID=12e9720e-4f8e-4630-8bc1-ca7c6a1cfca9

# Optional analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
