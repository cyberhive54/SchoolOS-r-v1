# SchoolOS Backend - Docker mode (backend + postgres + redis containers)
# Copy to .env when running via docker compose or docker run with local containers.

NODE_ENV=production
API_PORT=4000
API_PREFIX=v1

# Docker-local PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=schoolos
DATABASE_USER=schoolos
DATABASE_PASSWORD=change_me
DATABASE_URL=postgresql://schoolos:change_me@postgres:5432/schoolos
# Optional direct DB URL for migration scripts
# DIRECT_URL=postgresql://schoolos:change_me@postgres:5432/schoolos
DATABASE_SSL_MODE=disable

# Docker-local Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=change_me

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend origin(s) - comma-separated
CORS_ORIGINS=https://app.yourdomain.com
PLATFORM_DOMAIN=yourdomain.com

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Optional providers
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@yourdomain.com
SMS_PROVIDER=console
STORAGE_PROVIDER=local

# Security tuning
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_DEVICE_SESSIONS=3
