# SchoolOS Backend - Standalone mode (no Docker runtime)
# Recommended for VPS process managers (systemd/pm2) with managed services.
# Example stack: Supabase Postgres + Upstash Redis.

NODE_ENV=production
API_PORT=4000
API_PREFIX=v1

# Supabase Postgres (use Transaction/Session pooler URI from Supabase dashboard)
# Keep sslmode=require in URI OR set DATABASE_SSL_MODE=require below.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require
# For migrations, prefer direct connection when available.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres?sslmode=require
DATABASE_SSL_MODE=require

# Upstash Redis (use Redis URI, not REST URL)
# TLS endpoint usually starts with rediss://
REDIS_URL=rediss://default:<password>@<endpoint>:<port>
# Optional: override password separately if not embedded in URL
# REDIS_PASSWORD=<password>
# Optional (REST API values, not used by current backend Redis client):
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_hex_chars
JWT_REFRESH_SECRET=replace_with_64_hex_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend origin(s) - comma-separated
CORS_ORIGINS=https://app.yourdomain.com
PLATFORM_DOMAIN=yourdomain.com

# Cookie settings:
# - If frontend and backend are different domains (example: Vercel + Render), use none
# - If same-site deployment, strict is fine
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Optional providers
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@yourdomain.com
SMS_PROVIDER=console
STORAGE_PROVIDER=local

# Security tuning
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_DEVICE_SESSIONS=3
