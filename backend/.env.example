# SchoolOS Backend environment variables
# Copy this file to .env and fill real values before deployment.
# Never commit .env.
# This file is local/dev-friendly.
# For production templates, use:
# - .env.docker.example
# - .env.standalone.example

# Application
NODE_ENV=development
API_PORT=4000
API_PREFIX=v1

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=schoolos
DATABASE_USER=schoolos
DATABASE_PASSWORD=schoolos_dev_password
DATABASE_URL=postgresql://schoolos:schoolos_dev_password@localhost:5432/schoolos
# Optional direct DB URL for migration scripts (if different from DATABASE_URL)
# DIRECT_URL=postgresql://schoolos:schoolos_dev_password@localhost:5432/schoolos

# DB SSL mode: disable | require | verify-full
# - disable: plain TCP (typical for Docker-internal Postgres)
# - require: TLS without CA verification
# - verify-full: TLS with CA verification
DATABASE_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=change_me

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_32_char_min_secret
JWT_REFRESH_SECRET=change_me_to_another_random_32_char_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Auth cookie behavior
# In production behind HTTPS: COOKIE_SECURE=true
# For local HTTP-only testing: COOKIE_SECURE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Security
BCRYPT_ROUNDS=12

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:3000
PLATFORM_DOMAIN=localhost

# Optional providers
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@schoolos.com
SMS_PROVIDER=console
STORAGE_PROVIDER=local
